# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
#   cp .env.example .env.local
#
# .env.local ถูก gitignore ไว้ ห้าม commit ค่าจริงลง git เด็ดขาด
# บน Vercel ให้ตั้งค่าเหล่านี้ที่ Project Settings → Environment Variables

# ---------------------------------------------------------------- ฐานข้อมูล
# ไม่ใส่ = ใช้ไฟล์ JSON ใน ./data (เหมาะกับ dev เท่านั้น ไม่รอดบน Vercel)
# ใส่แล้ว = ใช้ MongoDB
#
# หาได้จาก MongoDB Atlas → Cluster → Connect → Drivers
# อย่าลืมใส่รหัสผ่านจริงแทน <password> และ url-encode อักขระพิเศษ
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# ชื่อฐานข้อมูลที่จะใช้ (ไม่ต้องสร้างไว้ก่อน Mongo สร้างให้อัตโนมัติ)
MONGODB_DB="imphodi"

# ------------------------------------------------------------------ session
# กุญแจเซ็น session cookie — ต้องยาว 32 ตัวอักษรขึ้นไป
#
# ถ้าไม่ตั้ง ตอน dev จะสร้างเก็บไว้ที่ data/.secret ให้เอง
# แต่บนโปรดักชัน "ต้องตั้ง" ไม่งั้น session จะหลุดทุกครั้งที่ deploy ใหม่
# เพราะ filesystem ของ serverless ไม่ถาวร
#
# สร้างค่าใหม่: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="ใส่ค่าสุ่มยาว 32 ตัวอักษรขึ้นไปที่นี่"

# ------------------------------------------------------------------- อื่น ๆ
# API key ของโมเดล AI — ยังไม่มีโค้ดส่วนไหนในโปรเจกต์เรียกใช้ตัวนี้
# เก็บไว้เผื่อทำฟีเจอร์ AI ในอนาคต (เช่น วิเคราะห์รูปอาหาร แนะนำเมนู)
# ถ้ายังไม่ใช้ ลบบรรทัดนี้ทิ้งได้เลย
MODEL_API_KEY=""
